# FundMatch environment variables. Copy to `.env.local` for local development.
# Never commit real values. `.env*` (except this file) is git-ignored.
#
# The public GitHub Pages demo needs NONE of these. The authenticated app
# (/app) needs the two VITE_ values in the browser bundle; the server-side
# values are only read by the TanStack Start server / backend workers.

# --- Browser (safe to expose: the publishable key only works with RLS) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server-side (TanStack Start / production host secrets) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service role: bypasses RLS. Only for trusted backend workers and never in
# any client bundle or Pages build.
SUPABASE_SERVICE_ROLE_KEY=

# --- Agentic intelligence (server-side only) ---
OPENAI_API_KEY=
# Model used by structured FundMatch workers. Keep this server-side and pin or
# version deliberately when production evals depend on behavior.
FUNDMATCH_AGENT_MODEL=
# agentic-v1 uses 1536 dimensions and defaults to text-embedding-3-small.
FUNDMATCH_EMBEDDING_MODEL=text-embedding-3-small
FUNDMATCH_AGENT_WORKFLOW_VERSION=agentic-v1

# --- Scheduled server actions ---
# Vercel Cron sends this value as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# Compatibility fallback for manual/non-Vercel drains.
FUNDMATCH_CRON_SECRET=
# Optional previous FundMatch value during secret rotation.
FUNDMATCH_CRON_SECRET_PREVIOUS=

# --- Migrations (drizzle-kit migrate). Use the direct/session pooler URL. ---
FUNDMATCH_DB_MIGRATION_URL=postgres://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Tests: a plain PostgreSQL database for the RLS policy tests ---
# FUNDMATCH_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/fundmatch_test
